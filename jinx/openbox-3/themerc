# Menu
menu.border.color: #F1DEDD

menu.title.bg: Solid Flat
menu.title.bg.color: #231919
menu.title.bg.shadow: 0
menu.title.text.color: #F1DEDD
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #231919
menu.items.text.color: #F1DEDD
menu.items.disabled.text.color: #bdacac

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #72333F
menu.items.active.text.color: #F1DEDD

menu.separator.color: #bdacac
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #231919

# Active window
window.active.border.color: #FFB3AE


window.active.title.bg: flat solid
window.active.title.bg.color: #231919
window.active.title.separator.color: #231919
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #F1DEDD

window.active.handle.bg: flat solid
window.active.handle.bg.color: #231919

window.active.grip.bg: flat solid
window.active.grip.bg.color: #231919

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #231919
window.active.button.unpressed.image.color: #F1DEDD

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #72333F
window.active.button.pressed.image.color: #FFD9DD

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #231919
window.active.button.disabled.image.color: #bdacac

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #231919
window.active.button.hover.image.color: #72333F

#window.active.button.toggled.bg: #72333F
#window.active.button.toggled.image.color: #FFD9DD

# Inactive window
window.inactive.border.color: #A08C8B

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #231919
window.inactive.title.separator.color: #231919
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #bdacac

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #231919

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #231919

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #231919
window.inactive.button.unpressed.image.color: #bdacac

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #72333F
window.inactive.button.pressed.image.color: #FFD9DD

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #bdacac
window.inactive.button.disabled.image.color: #231919

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #231919
window.inactive.button.hover.image.color: #72333F


# OSD
osd.border.width: 1
osd.border.color: #72333F

osd.bg: flat solid
osd.bg.color: #231919
osd.label.bg: flat solid
osd.label.bg.color: #231919
osd.label.text.color: #F1DEDD

# OSD
osd.bg: Solid Flat
osd.bg.color: #231919
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #72333F
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #1A1111

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #FFB3AE
#osd.button.unpressed.*.border.color: #571D1C

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #72333F
#osd.button.pressed.*.border.color: #FFD9DD

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #F1DEDD
#osd.button.focused.*.border.color: #1A1111

osd.button.focused.box.color: #72333F


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 8
padding.width: 8
padding.height: 8
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
