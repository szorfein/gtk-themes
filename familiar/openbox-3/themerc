# Menu
menu.border.color: #dee4e0

menu.title.bg: Solid Flat
menu.title.bg.color: #171d1b
menu.title.bg.shadow: 0
menu.title.text.color: #dee4e0
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #171d1b
menu.items.text.color: #dee4e0
menu.items.disabled.text.color: #acb2ae

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #334b45
menu.items.active.text.color: #dee4e0

menu.separator.color: #acb2ae
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #171d1b

# Active window
window.active.border.color: #85d6c1


window.active.title.bg: flat solid
window.active.title.bg.color: #171d1b
window.active.title.separator.color: #171d1b
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #dee4e0

window.active.handle.bg: flat solid
window.active.handle.bg.color: #171d1b

window.active.grip.bg: flat solid
window.active.grip.bg.color: #171d1b

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #171d1b
window.active.button.unpressed.image.color: #dee4e0

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #334b45
window.active.button.pressed.image.color: #cde8df

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #171d1b
window.active.button.disabled.image.color: #acb2ae

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #171d1b
window.active.button.hover.image.color: #334b45

#window.active.button.toggled.bg: #334b45
#window.active.button.toggled.image.color: #cde8df

# Inactive window
window.inactive.border.color: #89938f

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #171d1b
window.inactive.title.separator.color: #171d1b
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #acb2ae

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #171d1b

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #171d1b

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #171d1b
window.inactive.button.unpressed.image.color: #acb2ae

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #334b45
window.inactive.button.pressed.image.color: #cde8df

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #acb2ae
window.inactive.button.disabled.image.color: #171d1b

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #171d1b
window.inactive.button.hover.image.color: #334b45


# OSD
osd.border.width: 1
osd.border.color: #334b45

osd.bg: flat solid
osd.bg.color: #171d1b
osd.label.bg: flat solid
osd.label.bg.color: #171d1b
osd.label.text.color: #dee4e0

# OSD
osd.bg: Solid Flat
osd.bg.color: #171d1b
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #334b45
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #0e1513

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #85d6c1
#osd.button.unpressed.*.border.color: #00382e

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #334b45
#osd.button.pressed.*.border.color: #cde8df

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #dee4e0
#osd.button.focused.*.border.color: #0e1513

osd.button.focused.box.color: #334b45


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 8
padding.width: 8
padding.height: 8
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
