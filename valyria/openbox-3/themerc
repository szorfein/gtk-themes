# @TODO: finish replacing the colors here


# Menu
menu.border.color: #dfe2ef

menu.title.bg: Solid Flat
menu.title.bg.color: #171c25
menu.title.bg.shadow: 0
menu.title.text.color: #dfe2ef
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #171c25
menu.items.text.color: #dfe2ef
menu.items.disabled.text.color: #adb0bc

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #404565
menu.items.active.text.color: #dfe2ef

menu.separator.color: #adb0bc
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #171c25

# Active window
window.active.border.color: #acc7ff


window.active.title.bg: flat solid
window.active.title.bg.color: #171c25
window.active.title.separator.color: #171c25
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #dfe2ef

window.active.handle.bg: flat solid
window.active.handle.bg.color: #171c25

window.active.grip.bg: flat solid
window.active.grip.bg.color: #171c25

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #171c25
window.active.button.unpressed.image.color: #dfe2ef

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #404565
window.active.button.pressed.image.color: #dfe0ff

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #171c25
window.active.button.disabled.image.color: #adb0bc

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #171c25
window.active.button.hover.image.color: #404565

#window.active.button.toggled.bg: #404565
#window.active.button.toggled.image.color: #dfe0ff

# Inactive window
window.inactive.border.color: #8b909f

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #171c25
window.inactive.title.separator.color: #171c25
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #adb0bc

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #171c25

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #171c25

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #171c25
window.inactive.button.unpressed.image.color: #adb0bc

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #404565
window.inactive.button.pressed.image.color: #dfe0ff

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #adb0bc
window.inactive.button.disabled.image.color: #171c25

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #171c25
window.inactive.button.hover.image.color: #404565


# OSD
osd.border.width: 1
osd.border.color: #404565

osd.bg: flat solid
osd.bg.color: #171c25
osd.label.bg: flat solid
osd.label.bg.color: #171c25
osd.label.text.color: #dfe2ef

# OSD
osd.bg: Solid Flat
osd.bg.color: #171c25
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #404565
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #0f131c

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #acc7ff
#osd.button.unpressed.*.border.color: #002f67

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #404565
#osd.button.pressed.*.border.color: #dfe0ff

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #dfe2ef
#osd.button.focused.*.border.color: #0f131c

osd.button.focused.box.color: #404565


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 8
padding.width: 8
padding.height: 8
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
