# Menu
menu.border.color: #DFE3E5

menu.title.bg: Solid Flat
menu.title.bg.color: #181C1E
menu.title.bg.shadow: 0
menu.title.text.color: #DFE3E5
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #181C1E
menu.items.text.color: #DFE3E5
menu.items.disabled.text.color: #adb1b3

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #21444D
menu.items.active.text.color: #DFE3E5

menu.separator.color: #adb1b3
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #181C1E

# Active window
window.active.border.color: #70D4ED


window.active.title.bg: flat solid
window.active.title.bg.color: #181C1E
window.active.title.separator.color: #181C1E
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #DFE3E5

window.active.handle.bg: flat solid
window.active.handle.bg.color: #181C1E

window.active.grip.bg: flat solid
window.active.grip.bg.color: #181C1E

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #181C1E
window.active.button.unpressed.image.color: #DFE3E5

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #21444D
window.active.button.pressed.image.color: #B6DAE4

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #181C1E
window.active.button.disabled.image.color: #adb1b3

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #181C1E
window.active.button.hover.image.color: #21444D

#window.active.button.toggled.bg: #21444D
#window.active.button.toggled.image.color: #B6DAE4

# Inactive window
window.inactive.border.color: #879396

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #181C1E
window.inactive.title.separator.color: #181C1E
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #adb1b3

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #181C1E

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #181C1E

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #181C1E
window.inactive.button.unpressed.image.color: #adb1b3

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #21444D
window.inactive.button.pressed.image.color: #B6DAE4

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #adb1b3
window.inactive.button.disabled.image.color: #181C1E

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #181C1E
window.inactive.button.hover.image.color: #21444D


# OSD
osd.border.width: 1
osd.border.color: #21444D

osd.bg: flat solid
osd.bg.color: #181C1E
osd.label.bg: flat solid
osd.label.bg.color: #181C1E
osd.label.text.color: #DFE3E5

# OSD
osd.bg: Solid Flat
osd.bg.color: #181C1E
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #21444D
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #0F1416

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #70D4ED
#osd.button.unpressed.*.border.color: #003640

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #21444D
#osd.button.pressed.*.border.color: #B6DAE4

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #DFE3E5
#osd.button.focused.*.border.color: #0F1416

osd.button.focused.box.color: #21444D


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 8
padding.width: 8
padding.height: 8
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
