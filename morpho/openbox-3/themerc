# Menu
menu.border.color: #E6E0EA

menu.title.bg: Solid Flat
menu.title.bg.color: #1C1B21
menu.title.bg.shadow: 0
menu.title.text.color: #E6E0EA
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #1C1B21
menu.items.text.color: #E6E0EA
menu.items.disabled.text.color: #b3aeb7

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #433A63
menu.items.active.text.color: #E6E0EA

menu.separator.color: #b3aeb7
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #1C1B21

# Active window
window.active.border.color: #CDBDFF


window.active.title.bg: flat solid
window.active.title.bg.color: #1C1B21
window.active.title.separator.color: #1C1B21
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #E6E0EA

window.active.handle.bg: flat solid
window.active.handle.bg.color: #1C1B21

window.active.grip.bg: flat solid
window.active.grip.bg.color: #1C1B21

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #1C1B21
window.active.button.unpressed.image.color: #E6E0EA

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #433A63
window.active.button.pressed.image.color: #DBCEFF

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #1C1B21
window.active.button.disabled.image.color: #b3aeb7

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #1C1B21
window.active.button.hover.image.color: #433A63

#window.active.button.toggled.bg: #433A63
#window.active.button.toggled.image.color: #DBCEFF

# Inactive window
window.inactive.border.color: #948E9E

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1C1B21
window.inactive.title.separator.color: #1C1B21
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #b3aeb7

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #1C1B21

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #1C1B21

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #1C1B21
window.inactive.button.unpressed.image.color: #b3aeb7

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #433A63
window.inactive.button.pressed.image.color: #DBCEFF

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #b3aeb7
window.inactive.button.disabled.image.color: #1C1B21

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #1C1B21
window.inactive.button.hover.image.color: #433A63


# OSD
osd.border.width: 1
osd.border.color: #433A63

osd.bg: flat solid
osd.bg.color: #1C1B21
osd.label.bg: flat solid
osd.label.bg.color: #1C1B21
osd.label.text.color: #E6E0EA

# OSD
osd.bg: Solid Flat
osd.bg.color: #1C1B21
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #433A63
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #141219

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #CDBDFF
#osd.button.unpressed.*.border.color: #361387

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #433A63
#osd.button.pressed.*.border.color: #DBCEFF

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #E6E0EA
#osd.button.focused.*.border.color: #141219

osd.button.focused.box.color: #433A63


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 8
padding.width: 8
padding.height: 8
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
