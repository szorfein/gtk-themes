# @TODO: finish replacing the colors here


# Menu
menu.border.color: #E2E2E2

menu.title.bg: Solid Flat
menu.title.bg.color: #1B1B1B
menu.title.bg.shadow: 0
menu.title.text.color: #E2E2E2
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #1B1B1B
menu.items.text.color: #E2E2E2
menu.items.disabled.text.color: #b0b0b0

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #7F0E55
menu.items.active.text.color: #E2E2E2

menu.separator.color: #b0b0b0
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #1B1B1B

# Active window
window.active.border.color: #DAB9FE


window.active.title.bg: flat solid
window.active.title.bg.color: #1B1B1B
window.active.title.separator.color: #1B1B1B
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #E2E2E2

window.active.handle.bg: flat solid
window.active.handle.bg.color: #1B1B1B

window.active.grip.bg: flat solid
window.active.grip.bg.color: #1B1B1B

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #1B1B1B
window.active.button.unpressed.image.color: #E2E2E2

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #7F0E55
window.active.button.pressed.image.color: #FFCBE0

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #1B1B1B
window.active.button.disabled.image.color: #b0b0b0

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #1B1B1B
window.active.button.hover.image.color: #7F0E55

#window.active.button.toggled.bg: #7F0E55
#window.active.button.toggled.image.color: #FFCBE0

# Inactive window
window.inactive.border.color: #988E90

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1B1B1B
window.inactive.title.separator.color: #1B1B1B
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #b0b0b0

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #1B1B1B

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #1B1B1B

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #1B1B1B
window.inactive.button.unpressed.image.color: #b0b0b0

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #7F0E55
window.inactive.button.pressed.image.color: #FFCBE0

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #b0b0b0
window.inactive.button.disabled.image.color: #1B1B1B

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #1B1B1B
window.inactive.button.hover.image.color: #7F0E55


# OSD
osd.border.width: 1
osd.border.color: #7F0E55

osd.bg: flat solid
osd.bg.color: #1B1B1B
osd.label.bg: flat solid
osd.label.bg.color: #1B1B1B
osd.label.text.color: #E2E2E2

# OSD
osd.bg: Solid Flat
osd.bg.color: #1B1B1B
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #7F0E55
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #131313

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #DAB9FE
#osd.button.unpressed.*.border.color: #3E235D

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #7F0E55
#osd.button.pressed.*.border.color: #FFCBE0

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #E2E2E2
#osd.button.focused.*.border.color: #131313

osd.button.focused.box.color: #7F0E55


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 8
padding.width: 8
padding.height: 8
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
